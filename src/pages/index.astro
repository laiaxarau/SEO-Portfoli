---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Approach from '../components/Approach.astro';
import Toolkit from '../components/Toolkit.astro';
import About from '../components/About.astro';
import Journey from '../components/Journey.astro';
import Beyond from '../components/Beyond.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <div id="top">
    <Header />
    <main id="main">
      <Hero />
      <Services />
      <SelectedWork />
      <Approach />
      <Toolkit />
      <About />
      <Journey />
      <Beyond />
      <Contact />
    </main>
    <Footer />
  </div>
</BaseLayout>
