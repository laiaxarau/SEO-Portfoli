---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const w = t.work;
---

<section id="work" aria-labelledby="work-title">
  <div class="wrap section work">
    <div class="stack section-head">
      <p class="eyebrow"><span aria-hidden="true">01 / </span>{w.eyebrow}</p>
      <h2 id="work-title" class="h2">{w.title}</h2>
      <p class="body work__intro">{w.intro}</p>
    </div>

    {w.cases.map((cas) => (
      <article class="case">
        <header class="case__header">
          <span class="case__num" aria-hidden="true">{cas.num}</span>
          <div class="case__heading">
            <p class="case__meta">{cas.meta}</p>
            <h3 class="case__title">{cas.title}</h3>
          </div>
        </header>

        <div class="case__grid">
          <div class="case__item">
            <h4 class="case__label">{w.labelContext}</h4>
            <p class="case__text">{cas.context}</p>
          </div>
          <div class="case__item">
            <h4 class="case__label">{w.labelChallenge}</h4>
            <p class="case__text">{cas.challenge}</p>
          </div>
          <div class="case__item">
            <h4 class="case__label">{w.labelApproach}</h4>
            <ul class="case__list">
              {cas.approach.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="case__item case__item--result">
            <h4 class="case__label">{w.labelResult}</h4>
            <p class="case__result">{cas.result}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .work__intro {
    max-width: 720px;
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s;
  }

  .case:hover {
    border-color: var(--ink);
  }

  .case__header {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .case__num {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.9;
    color: var(--line-strong);
    flex-shrink: 0;
    user-select: none;
  }

  .case__heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
  }

  .case__meta {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .case__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.2;
  }

  .case__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .case__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .case__item--result {
    grid-column: 1 / -1;
    padding: 24px;
    background: var(--ink);
    border-radius: calc(var(--radius) - 4px);
    color: var(--bg);
  }

  .case__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .case__item--result .case__label {
    color: var(--detail-light);
  }

  .case__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .case__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case__list li {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body);
    padding-left: 16px;
    position: relative;
  }

  .case__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .case__result {
    font-size: 16px;
    line-height: 1.65;
    color: var(--line);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .case__header {
      flex-direction: column;
      gap: 12px;
    }

    .case__num {
      font-size: 40px;
    }

    .case__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
