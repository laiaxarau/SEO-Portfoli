---
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';
import seoAmbTalonsImg from '../assets/projects/seo-amb-talons.png';
import madridImg from '../assets/projects/madrid.png';
import frontendPortfolioImg from '../assets/projects/frontend-portfolio.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const w = t.work;

const projectImages = [seoAmbTalonsImg, madridImg, frontendPortfolioImg];
const projectLinks = [SITE.links.seoAmbTalons, SITE.links.madrid, SITE.links.frontendPortfolio];
---

<section id="work" aria-labelledby="work-title">
  <div class="wrap section work">
    <div class="stack section-head">
      <p class="eyebrow"><span aria-hidden="true">02 / </span>{w.eyebrow}</p>
      <h2 id="work-title" class="h2">{w.title}</h2>
    </div>

    <article class="card featured">
      <div class="featured__text">
        <p class="card__meta">{w.featured.meta}</p>
        <h3 class="featured__title">{w.featured.title}</h3>
        <p class="card__text">{w.featured.text}</p>
        <p class="featured__note">{w.featured.note}</p>
      </div>
      <figure class="featured__visual terminal" aria-label={t.a11y.terminalAlt}>
        <div class="terminal__bar" aria-hidden="true">
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__name">seo-audit</span>
        </div>
        <div class="terminal__body" aria-hidden="true">
          <p class="terminal__cmd"><span class="terminal__prompt">$</span> seo-audit --site client.com</p>
          <ul class="terminal__log">
            {
              w.auditSteps.map((step) => (
                <li>
                  <span class="terminal__check">✓</span>
                  <span class="terminal__step">{step.name}</span>
                  <span class="terminal__note">{step.note}</span>
                </li>
              ))
            }
          </ul>
          <p class="terminal__result">
            <span class="terminal__arrow">→</span> {w.terminalResult}<span class="terminal__cursor"></span>
          </p>
        </div>
      </figure>
    </article>

    <div class="projects">
      {
        w.projects.map((project, i) => (
          <article class="card project">
            <Image
              src={projectImages[i]}
              alt={project.alt}
              widths={[400, 640, 800]}
              sizes="(max-width: 720px) 100vw, 400px"
              class="project__visual"
            />
            <div class="project__body">
              <p class="card__meta">{project.meta}</p>
              <h3 class="h3">{project.title}</h3>
              <p class="card__text project__text">{project.text}</p>
              <a href={projectLinks[i]} class="card__link">
                {project.linkLabel}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--ink);
  }

  .card__meta {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .featured__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: clamp(28px, 4vw, 48px);
  }

  .featured__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1.1;
  }

  .featured .card__text {
    font-size: 17px;
  }

  .featured__note {
    font-size: 15px;
    color: var(--text-subtle);
  }

  .featured__visual {
    min-height: 280px;
    margin: 0;
    background: var(--ink);
    color: var(--text-on-dark);
  }

  .terminal {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line-dark);
  }

  .terminal__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-dark);
  }

  .terminal__name {
    margin-left: 8px;
    font-size: 12px;
    color: #8A8D93;
  }

  .terminal__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    flex-grow: 1;
    padding: clamp(20px, 3vw, 32px);
  }

  .terminal__cmd {
    color: var(--bg);
  }

  .terminal__prompt,
  .terminal__arrow {
    color: var(--detail-light);
  }

  .terminal__log {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .terminal__log li {
    display: grid;
    grid-template-columns: 18px 160px minmax(0, 1fr);
    gap: 8px;
  }

  .terminal__check {
    color: var(--accent-light);
  }

  .terminal__step {
    color: var(--bg);
  }

  .terminal__note {
    color: #8A8D93;
  }

  .terminal__result {
    color: var(--bg);
  }

  .terminal__cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 4px;
    vertical-align: -2px;
    background: var(--accent-light);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__cursor { animation: none; }
  }

  @media (max-width: 480px) {
    .terminal__log li {
      grid-template-columns: 18px minmax(0, 1fr);
    }
    .terminal__note {
      grid-column: 2;
    }
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .project {
    display: flex;
    flex-direction: column;
  }

  .project__visual {
    width: 100%;
    height: auto;
    aspect-ratio: 1261 / 860;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-grow: 1;
    padding: 28px;
  }

  .project__text {
    flex-grow: 1;
  }

  @media (max-width: 720px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
