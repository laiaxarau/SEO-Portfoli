---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.services;
---

<section class="interstitial" aria-labelledby="interstitial-title">
  <div class="wrap section interstitial__inner">
    <h2 id="interstitial-title" class="interstitial__title">{s.title}</h2>
    <p class="body interstitial__body">{s.body}</p>
  </div>
</section>

<style>
  .interstitial {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .interstitial__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(48px, 6vw, 80px);
  }

  .interstitial__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.2;
  }

  .interstitial__body {
    color: var(--text-body);
    font-size: 18px;
    line-height: 1.65;
  }

  @media (max-width: 720px) {
    .interstitial__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
