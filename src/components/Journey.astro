---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const j = t.journey;
---

<section id="journey" class="journey" aria-labelledby="journey-title">
  <div class="wrap section journey__inner">
    <div class="split section-head">
      <div class="stack">
        <p class="eyebrow journey__eyebrow"><span aria-hidden="true">03 / </span>{j.eyebrow}</p>
        <h2 id="journey-title" class="h2">{j.title}</h2>
      </div>
      <p class="body journey__intro">{j.intro}</p>
    </div>
    <ol class="steps">
      {
        j.steps.map((step, i) => (
          <li class:list={['step', { 'step--last': i === j.steps.length - 1 }]}>
            <span class="step__label">
              <span aria-hidden="true">{step.num} · </span>
              {step.label}
            </span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .journey {
    background: var(--secondary);
    border-top: 1px solid var(--line);
  }

  .journey__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .journey__intro {
    align-self: end;
  }

  .journey__eyebrow,
  .step__label {
    color: var(--detail-strong);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    counter-reset: steps;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 28px 24px 0;
    border-left: 2px solid var(--line-strong);
    padding-left: 24px;
    margin-right: 4px;
  }

  .step--last {
    border-left-color: var(--accent);
  }

  .step__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.2;
  }

  .step__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
  }

  @media (max-width: 720px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      border-left: none;
      border-top: 2px solid var(--line-strong);
      padding-left: 0;
      padding-top: 20px;
    }

    .step--last {
      border-top-color: var(--accent);
    }
  }
</style>
