---
import { SITE } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <p class="eyebrow contact__eyebrow"><span aria-hidden="true">08 / </span>{c.eyebrow}</p>
    <h2 id="contact-title" class="contact__title">
      {lang === 'ca' ? <>{c.title.replace('Parlem', '')}<span class="contact__accent">Parlem</span></> :
       lang === 'es' ? <>{c.title.replace('Hablemos', '')}<span class="contact__accent">Hablemos</span></> :
       <>Let's <span class="contact__accent">talk</span></>}
    </h2>
    <p class="contact__text">{c.text}</p>
    <div class="btn-row">
      <a href={SITE.linkedin} class="btn btn--light" rel="me">
        {c.linkedin}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a href={`mailto:${SITE.email}`} class="btn btn--outline-light">
        {c.email}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--bg);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(72px, 10vw, 136px);
  }

  .contact__eyebrow {
    color: var(--detail-light);
  }

  .contact__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(56px, 8.5vw, 112px);
    line-height: 0.95;
  }

  .contact__accent {
    color: var(--accent-light);
  }

  .contact__text {
    max-width: 640px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--line);
  }

  .btn--light {
    background: var(--bg);
    color: var(--ink);
  }

  .btn--light:hover {
    background: var(--accent-light);
    color: var(--ink);
  }

  .btn--outline-light {
    border: 1px solid #5C5F64;
    color: var(--bg);
  }

  .btn--outline-light:hover {
    border-color: var(--accent-light);
    color: var(--accent-light);
  }
</style>
