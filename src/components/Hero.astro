---
import { SITE } from '../data/site';

const domain = SITE.url.replace(/^https?:\/\//, '');
---

<section aria-labelledby="hero-title">
  <div class="wrap hero">
    <div class="hero__text">
      <p class="eyebrow">Independent thinking. Technical understanding.</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">Laia Xarau</span>{' '}
        <span class="hero__role">SEO Consultant — Technical SEO &amp; Strategy</span>
      </h1>
      <p class="hero__claim">
        Search is complex.<br />
        <span class="accent">Understanding it is my job.</span>
      </p>
      <p class="hero__intro">
        I combine technical SEO, data analysis and a developer's perspective to help websites
        improve their organic visibility and connect with the right audiences.
      </p>
      <div class="btn-row">
        <a href="#work" class="btn btn--primary">
          Explore my work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
        <a href="#contact" class="btn btn--ghost">Get in touch</a>
      </div>
    </div>

    <figure class="preview" aria-label="How this page presents itself in search results and structured data">
      <div class="preview__bar">
        <span>SEARCH RESULT PREVIEW</span>
        <span aria-hidden="true">01 / 03</span>
      </div>
      <div class="preview__serp">
        <div class="preview__site">
          <span class="preview__avatar" aria-hidden="true">LX</span>
          <span class="preview__siteinfo">
            <span>{SITE.name}</span>
            <span class="preview__url">https://{domain}</span>
          </span>
        </div>
        <p class="preview__title">{SITE.title}</p>
        <p class="preview__desc">{SITE.description}</p>
      </div>
      <pre class="preview__code"><span class="c">&lt;script type="application/ld+json"&gt;</span>
{'{'}
  <span class="k">"@type"</span>: "Person",
  <span class="k">"name"</span>: "{SITE.name}",
  <span class="k">"jobTitle"</span>: "{SITE.jobTitle}",
  <span class="k">"sameAs"</span>: ["LinkedIn"]
{'}'}
<span class="c">&lt;/script&gt;</span></pre>
    </figure>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-top: clamp(32px, 4vw, 56px);
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-weight: var(--display-weight);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(56px, 8.5vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .hero__role {
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.3;
    font-weight: 500;
    color: var(--text-body);
  }

  .hero__claim {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.15;
    max-width: 580px;
  }

  .hero__intro {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 560px;
  }

  .preview {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .preview__bar {
    display: flex;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-subtle);
  }

  .preview__serp {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 24px 20px;
  }

  .preview__site {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .preview__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .preview__siteinfo {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.3;
  }

  .preview__url {
    color: var(--text-subtle);
  }

  .preview__title {
    margin-top: 6px;
    font-size: 20px;
    line-height: 1.3;
    color: #1A0DAB;
  }

  .preview__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .preview__code {
    margin: 0;
    padding: 20px 24px;
    background: var(--ink);
    color: var(--line);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .preview__code .c {
    color: #8A8D93;
  }

  .preview__code .k {
    color: var(--accent-light);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
