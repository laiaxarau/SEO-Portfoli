---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.about;
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap section split">
    <div class="stack">
      <p class="eyebrow"><span aria-hidden="true">05 / </span>{a.eyebrow}</p>
      <h2 id="about-title" class="h2">{a.title}</h2>
    </div>
    <div class="body about__text">
      <p>{a.p1}</p>
      <p>{a.p2}</p>
      <p>{a.p3}</p>
      <blockquote class="quote about__quote">{a.quote}</blockquote>
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about__quote {
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
