---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.approach;
---

<section id="approach" class="approach-section" aria-labelledby="approach-title">
  <div class="wrap section approach">
    <div class="split">
      <div class="stack">
        <p class="eyebrow"><span aria-hidden="true">02 / </span>{a.eyebrow}</p>
        <h2 id="approach-title" class="h2">{a.title}</h2>
      </div>
      <p class="body approach__intro">{a.intro}</p>
    </div>

    <div class="areas">
      {a.areas.map((area) => (
        <article class="area">
          <header class="area__head">
            <p class="area__num" aria-hidden="true">{area.num}</p>
            <p class="area__label">{area.label}</p>
          </header>
          <h3 class="area__title">{area.title}</h3>
          <p class="area__text">{area.text}</p>
          <ul class="chips" aria-label={area.label}>
            {area.chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .approach-section {
    border-top: 1px solid var(--line);
  }

  .approach {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .approach__intro {
    align-self: end;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }

  .area:hover {
    border-color: var(--ink);
  }

  /* Alternate dark card for visual rhythm */
  .area:nth-child(even) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .area__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .area__num {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 36px;
    line-height: 1;
    color: var(--line-strong);
    user-select: none;
  }

  .area:nth-child(even) .area__num {
    color: #3a3d42;
  }

  .area__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .area:nth-child(even) .area__label {
    color: var(--accent-light);
  }

  .area__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 22px;
    line-height: 1.2;
  }

  .area__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    flex-grow: 1;
  }

  .area:nth-child(even) .area__text {
    color: var(--line);
  }

  .area:nth-child(even) .chips li {
    background: transparent;
    border-color: #3a3d42;
    color: var(--line);
  }

  @media (max-width: 720px) {
    .areas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
