---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.approach;
---

<section id="approach" class="approach-section" aria-labelledby="approach-title">
  <div class="wrap section approach">
    <div class="split">
      <div class="stack">
        <p class="eyebrow"><span aria-hidden="true">03 / </span>{a.eyebrow}</p>
        <h2 id="approach-title" class="h2">{a.title}</h2>
      </div>
      <div class="approach__intro">
        <p class="lead-display">
          {a.leadLine1}{' '}
          <span class="accent">{a.leadAccent}</span>
        </p>
        <p class="body">{a.body}</p>
      </div>
    </div>

    <div class="perspectives">
      <div class="perspective">
        <p class="perspective__label">{a.perspective1Label}<span aria-hidden="true"> 01</span></p>
        <h3 class="h3">{a.perspective1Title}</h3>
        <p class="perspective__text">{a.perspective1Text}</p>
        <ul class="chips" aria-label={a.perspective1Title}>
          {a.perspective1Chips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
      <div class="perspective perspective--dark">
        <p class="perspective__label">{a.perspective2Label}<span aria-hidden="true"> 02</span></p>
        <h3 class="h3">{a.perspective2Title}</h3>
        <p class="perspective__text">{a.perspective2Text}</p>
        <ul class="chips" aria-label={a.perspective2Title}>
          {a.perspective2Chips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
    </div>

    <div class="split approach__close">
      <p class="body">{a.close1}</p>
      <p class="quote">{a.close2}</p>
    </div>
  </div>
</section>

<style>
  .approach-section {
    border-top: 1px solid var(--line);
  }

  .approach {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .approach__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .perspectives {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .perspective {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .perspective__label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .perspective__text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .perspective--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .perspective--dark .perspective__label {
    color: var(--line-strong);
  }

  .perspective--dark .perspective__text {
    color: var(--line);
  }

  .perspective--dark .chips li {
    background: transparent;
    border-color: var(--line-dark);
  }

  .approach__close {
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
</style>
