---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const b = t.beyond;
---

<section class="beyond" aria-labelledby="beyond-title">
  <div class="wrap section split">
    <div class="stack">
      <p class="eyebrow"><span aria-hidden="true">07 / </span>{b.eyebrow}</p>
      <h2 id="beyond-title" class="h2">{b.title}</h2>
    </div>
    <div class="beyond__text">
      <p class="body">{b.p}</p>
      <p class="quote">{b.quote}</p>
    </div>
  </div>
</section>

<style>
  .beyond {
    border-top: 1px solid var(--line);
  }

  .beyond__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
