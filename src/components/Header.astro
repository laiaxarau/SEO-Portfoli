---
import Logo from './Logo.astro';
import { useTranslations, langPaths, langLabels, locales, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { href: '#work',     label: t.header.nav.work },
  { href: '#approach', label: t.header.nav.approach },
  { href: '#journey',  label: t.header.nav.journey },
  { href: '#toolkit',  label: t.header.nav.toolkit },
  { href: '#about',    label: t.header.nav.about },
];
---

<header class="header">
  <div class="wrap header__inner">
    <div class="brand">
      <Logo lang={lang} />
      <span class="brand__tag">{t.header.tagline}</span>
    </div>

    <nav aria-label="Main" class="nav">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="header__actions">
      <nav class="lang-switcher" aria-label={t.header.langLabel}>
        {locales.map((l) => (
          <a
            href={langPaths[l]}
            aria-current={l === lang ? 'page' : undefined}
            class:list={['lang-switcher__link', { 'lang-switcher__link--active': l === lang }]}
            hreflang={l}
          >
            {langLabels[l]}
          </a>
        ))}
      </nav>
      <a href="#contact" class="btn btn--primary btn--small">{t.header.cta}</a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 88px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
  }

  .nav a {
    text-decoration: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang-switcher {
    display: flex;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .lang-switcher__link {
    padding: 4px 6px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-subtle);
    transition: color 0.15s;
  }

  .lang-switcher__link:hover {
    color: var(--ink);
  }

  .lang-switcher__link--active {
    color: var(--ink);
    background: var(--surface);
  }

  @media (max-width: 900px) {
    .nav,
    .brand__tag {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .lang-switcher {
      display: none;
    }
  }
</style>
